[build-system]
requires = ["setuptools>=64"]
build-backend = "setuptools.build_meta"

[project]
name = "{{REPO}}"
version = "0.1.0"
description = "TO FILL: what the package does, in a sentence"
readme = "README.md"
requires-python = ">=3.11"
dependencies = []

[tool.setuptools.packages.find]
include = ["mbse*"]
namespaces = true

[tool.setuptools.package-data]
"mbse.{{PACKAGE}}" = ["skill/*.md"]

[dependency-groups]
dev = [
    "coverage[toml]>=7.10",
    "ipykernel>=7.3.0",
    "nbformat>=5.11.1",
    "nbmake>=1.5.5",
    "pytest>=9.1.1",
]

[tool.pytest.ini_options]
testpaths = ["tests", "tutorials"]
addopts = "--nbmake"

[tool.coverage.run]
source = ["mbse.{{PACKAGE}}"]
branch = true
parallel = true
patch = ["subprocess"]
sigterm = true  # a notebook kernel stopped by SIGTERM at shutdown saves its data

[tool.coverage.report]
show_missing = true
skip_covered = false
fail_under = 100
